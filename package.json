{
  "name": "ai-tool-elements",
  "version": "0.2.0",
  "description": "Composable React UI for tools and connectors.",
  "keywords": [
    "ai",
    "connectors",
    "react",
    "shadcn",
    "tools",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omavashia2005/ai-tool-elements.git"
  },
  "bugs": {
    "url": "https://github.com/omavashia2005/ai-tool-elements/issues"
  },
  "homepage": "https://github.com/omavashia2005/ai-tool-elements#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "workspaces": [
    "examples/basic"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tailwindcss -i src/styles.css -o dist/index.css --minify",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test",
    "doctor": "npx react-doctor@latest",
    "example": "npm run build && npm run dev --workspace ai-tool-elements-example",
    "example:build": "npm run build && npm run build --workspace ai-tool-elements-example"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@thesvg/icons": "^3.2.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.3",
    "react": "^19.1.0",
    "react-doctor": "^0.9.1",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
